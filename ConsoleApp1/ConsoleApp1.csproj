<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<AssemblyName>DungeonEscape</AssemblyName>
		<RootNamespace>ConsoleApp1</RootNamespace>
		<Company>owentech30</Company>
		<Authors>owentech30</Authors>
		<Product>Dungeon Escape</Product>
		<Version>1.0.0</Version>
		<Description>A polished console dungeon adventure game with difficulty settings and styled output.</Description>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<AnalysisLevel>latest</AnalysisLevel>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
	</ItemGroup>

</Project>
